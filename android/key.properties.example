# 이 파일을 복사해 android/key.properties 로 저장한 뒤 값을 채우세요.
# key.properties 는 Git에 커밋하지 마세요 (.gitignore 됨).
#
# 키스토어 생성 예시 (JDK keytool: 별칭은 -alias 입니다. -keyalias 는 오류 납니다)
# keytool -genkeypair -v -keystore upload-keystore.jks -storetype JKS -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile 은 android/ 폴더 기준 상대 경로이거나, 절대 경로를 사용할 수 있습니다.
# 예: 키스토어를 android/ 아래에 두면 storeFile=upload-keystore.jks
# 예: 프로젝트 루트에 두면 storeFile=../upload-keystore.jks

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
